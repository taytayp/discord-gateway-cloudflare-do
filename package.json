{
  "name": "discord-gateway-cloudflare-do",
  "version": "0.1.3",
  "description": "Cloudflare Durable Objects Discord Gateway for Chat SDK — persistent WebSocket with session resume, heartbeat via alarms, and automatic reconnection",
  "type": "module",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "types": "./src/types.ts",
  "exports": {
    ".": {
      "types": "./src/types.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "chat-sdk",
    "discord",
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "gateway",
    "websocket",
    "chat-adapter"
  ],
  "author": "Dan Carter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dcartertwo/discord-gateway-cloudflare-do.git"
  },
  "homepage": "https://github.com/dcartertwo/discord-gateway-cloudflare-do#readme",
  "bugs": {
    "url": "https://github.com/dcartertwo/discord-gateway-cloudflare-do/issues"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.5",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@vitest/runner": "^4.1.12",
    "@vitest/snapshot": "^4.1.12",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.166.0"
  },
  "allowScripts": {
    "esbuild@0.27.3": true,
    "esbuild@0.28.2": true,
    "sharp@0.34.5": true,
    "workerd@1.20261118.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261119.1": true
  }
}
