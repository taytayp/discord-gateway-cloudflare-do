// Wrangler config for vitest — not used at deploy time.
// Consumers define their own wrangler config with the DO binding.
{
  "name": "peat-botly",
  "main": "src/index.ts",
 "compatibility_date": "2026-10-27",
  "durable_objects": {
    "bindings": [
      { "name": "DISCORD_GATEWAY", "class_name": "DiscordGatewayDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DiscordGatewayDO"] }
  ]
}
